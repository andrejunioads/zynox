      "parameters": {
        "functionCode": "// Processar dados recebidos\nconst tipo = $input.item.json.tipo || 'notification';\nconst titulo = $input.item.json.titulo || 'Notificação Zynox';\nconst mensagem = $input.item.json.mensagem || '';\nconst prioridade = $input.item.json.prioridade || 'medium';\nconst actionUrl = $input.item.json.actionUrl || '/';\n\n// Mapear prioridade\nlet pushoverPriority = 0;\nif (prioridade === 'urgent') pushoverPriority = 2;\nelse if (prioridade === 'high') pushoverPriority = 1;\nelse if (prioridade === 'low') pushoverPriority = -1;\n\n// Mapear som por tipo\nconst sounds = {\n  'lead': 'cosmic',\n  'meeting': 'siren',\n  'task': 'pushover',\n  'project': 'intermission',\n  'financial': 'cashregister',\n  'team': 'bugle'\n};\nconst sound = sounds[tipo] || 'pushover';\n\nreturn {\n  json: {\n    titulo,\n    mensagem,\n    tipo,\n    prioridade: pushoverPriority,\n    sound,\n    actionUrl: 'https://zynox-crm-3e828.web.app' + actionUrl,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "id": "function-1",
      "name": "Process Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
